{
  "model": {
    "model_type": "clip",
    "variant": "base-patch16",
    "device": null,
    "batch_size": 64,
    "num_workers": 4,
    "proxy": null
  },
  "pooling": {
    "strategy": "gem",
    "params": {
      "p": 3.0
    }
  },
  "clustering": {
    "method": "kmeans",
    "params": {
      "n_clusters": 20
    }
  },
  "n_clients": 10,
  "cache_dir": "./.embedding_cache",
  "cache_enabled": true,
  "assignment_strategy": "size_balanced",
  "handle_noise": "distribute"
}
