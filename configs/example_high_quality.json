{
  "model": {
    "model_type": "dinov2",
    "variant": "large",
    "device": null,
    "batch_size": 16,
    "num_workers": 4,
    "proxy": null
  },
  "pooling": {
    "strategy": "gem",
    "params": {
      "p": 3.0
    }
  },
  "clustering": {
    "method": "hdbscan",
    "params": {
      "min_cluster_size": 10
    }
  },
  "n_clients": 10,
  "cache_dir": "./.embedding_cache",
  "cache_enabled": true,
  "assignment_strategy": "size_balanced",
  "handle_noise": "distribute"
}
